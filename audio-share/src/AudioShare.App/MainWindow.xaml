<Window x:Class="AudioShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowCast - 音乐分享"
        Icon="/Assets/flowcast-logo.ico"
        Width="1500"
        Height="860"
        MinWidth="1500"
        MaxWidth="1500"
        MinHeight="860"
        MaxHeight="860"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#F4F8FC"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="5" Opacity="0.08" Color="#45678F" />
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="10" ShadowDepth="3" Opacity="0.14" Color="#2477DB" />

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#C9FDFEFF" />
            <Setter Property="BorderBrush" Value="#9EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
        <Style x:Key="UtilityButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#A8FFFFFF" />
            <Setter Property="BorderBrush" Value="#B8D7E1EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#29425D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#1976F3" />
            <Setter Property="BorderBrush" Value="#5AA7FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E85558" />
            <Setter Property="BorderBrush" Value="#FF9697" />
        </Style>
        <Style x:Key="ProgramCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="22" Height="22" Background="#A8FFFFFF" BorderBrush="#9EB2C9" BorderThickness="1.4" CornerRadius="11">
                            <Path x:Name="Check" Data="M 5,11 L 9,15 L 17,7" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#006CFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#006CFF" />
                                <Setter TargetName="Check" Property="StrokeThickness" Value="2.8" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#D8FFFFFF" />
            <Setter Property="BorderBrush" Value="#B6C7D9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="WindowCommandButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#3A526B" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CommandSurface" Margin="3" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CommandSurface" Property="Background" Value="#E6EFF7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CommandSurface" Property="Background" Value="#D5E4F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7FBFF" Offset="0" />
                    <GradientStop Color="#EDF5FF" Offset="0.55" />
                    <GradientStop Color="#F2FAF8" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="420" Height="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-120,0" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A3DBFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="300" Height="270" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-100" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFB9A6" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid x:Name="MainContent" Margin="28,58,28,28" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="LogoMark" Width="48" Height="48" Margin="0,0,12,0" Background="#BFFFFFFF" CornerRadius="15" Effect="{StaticResource SoftShadow}">
                        <Image Margin="8" Source="/Assets/flowcast-logo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#172D45" Text="FlowCast" />
                        <TextBlock Margin="1,1,0,0" Foreground="#687D94" Text="音乐分享" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource UtilityButton}" Click="SettingsButton_Click" Content="设置" />
                    <Button Style="{StaticResource UtilityButton}" Click="TutorialButton_Click" Content="教程" />
                    <Button Style="{StaticResource UtilityButton}" Click="ShareHistoryButton_Click" Content="历史" />
                    <Button x:Name="UpdateButton" Style="{StaticResource UtilityButton}" Visibility="Collapsed" Click="UpdateButton_Click" Content="更新" />
                    <Button x:Name="RefreshButton" Style="{StaticResource UtilityButton}" Margin="0" Click="RefreshButton_Click" Content="刷新" />
                </StackPanel>
            </Grid>

            <Border x:Name="TopStatusCard" Grid.Row="1" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LaunchSheen" Grid.ColumnSpan="3" CornerRadius="14" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#74FFFFFF" Offset="0.5" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="StatusPulse" Width="70" Height="70" Background="#CFFFFFFF" BorderBrush="#DFFFFFFF" BorderThickness="1" CornerRadius="35" VerticalAlignment="Center">
                        <Viewbox Margin="18">
                            <Path Data="M 4,12 C 4,7 8,4 12,4 C 16,4 20,7 20,12 M 8,12 C 8,9 10,8 12,8 C 14,8 16,9 16,12 M 2,10 L 2,14 M 22,10 L 22,14" Stroke="#12AFC0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Border>
                    <Grid Grid.Column="1" Margin="18,0,28,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="126" Height="28" IsHitTestVisible="False">
                        <Path x:Name="RouteFlowPath" VerticalAlignment="Center" Data="M 0,12 C 18,0 38,24 60,12 S 102,0 126,12" Stroke="#48CFC3" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.64" />
                        <Canvas Width="126" Height="28">
                            <Ellipse x:Name="RouteBeaconOne" Width="7" Height="7" Canvas.Left="0" Canvas.Top="9" Fill="#18AFC0" Opacity="0" />
                            <Ellipse x:Name="RouteBeaconTwo" Width="7" Height="7" Canvas.Left="0" Canvas.Top="9" Fill="#7ADCD4" Opacity="0" />
                        </Canvas>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FlowCastStatusText" FontSize="27" FontWeight="SemiBold" Foreground="#117F95" Text="正在确认分享状态" />
                        <TextBlock x:Name="FlowCastStatusHintText" Margin="0,5,0,0" FontSize="14" Foreground="#496C82" TextWrapping="Wrap" Text="正在检查当前程序。" />
                        <TextBlock x:Name="B1StatusText" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#278093" Text="B1：正在检测" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="100" Height="6" Background="#D6E8EE" CornerRadius="3" ClipToBounds="True">
                                <Border x:Name="B1MeterFill" Width="0" HorizontalAlignment="Left" Background="#1BBFAD" CornerRadius="3" />
                            </Border>
                            <TextBlock x:Name="B1MeterValueText" Margin="8,0,0,0" FontSize="12" Foreground="#70869A" Text="0%" />
                        </StackPanel>
                        <TextBlock x:Name="B1SelfTestText" Margin="0,6,0,0" FontSize="12" Foreground="#70869A" Text="B1 自测：开始分享后会在这里确认音频信号。" />
                        <TextBlock x:Name="TotalShareDurationText" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#278093" Text="累计分享 00:00:00" />
                        <TextBlock x:Name="RecentActivityText" Margin="0,8,0,0" FontSize="12" Foreground="#70869A" TextWrapping="Wrap" />
                        <StackPanel x:Name="B1ActivityBars" Margin="0,13,0,0" Orientation="Horizontal" Opacity="0.65">
                            <Rectangle Width="4" Height="10" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="20" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="14" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="27" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="17" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="10" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                        </StackPanel>
                        <StackPanel Margin="0,13,0,0" Orientation="Horizontal" Height="26" VerticalAlignment="Bottom">
                            <Border x:Name="AtmosphereBarOne" Width="6" Height="18" Margin="0,0,5,0" Background="#36C8C2" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarTwo" Width="6" Height="26" Margin="0,0,5,0" Background="#48CFC3" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarThree" Width="6" Height="15" Margin="0,0,5,0" Background="#36C8C2" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarFour" Width="6" Height="24" Margin="0,0,5,0" Background="#48CFC3" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarFive" Width="6" Height="20" Margin="0,0,5,0" Background="#36C8C2" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarSix" Width="6" Height="28" Margin="0,0,5,0" Background="#48CFC3" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarSeven" Width="6" Height="16" Margin="0,0,5,0" Background="#36C8C2" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                            <Border x:Name="AtmosphereBarEight" Width="6" Height="22" Background="#48CFC3" CornerRadius="3" RenderTransformOrigin="0.5,1" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MuteSharingButton" Style="{StaticResource UtilityButton}" IsEnabled="False" Click="MuteSharingButton_Click" Content="静音分享" />
                        <Button x:Name="RestoreRoutingButton" Style="{StaticResource DangerButton}" Margin="0" IsEnabled="False" Click="RestoreRoutingButton_Click" Content="停止分享" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ApplicationListPanel" Grid.Row="2" Style="{StaticResource GlassCard}" Padding="22" MinHeight="390">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#203A56" Text="正在播放的程序" />
                            <TextBlock Margin="0,4,0,0" Foreground="#74879A" Text="勾选后，朋友才会听到该程序；分享中可拖动已选程序调整顺序。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Style="{StaticResource UtilityButton}" Margin="0" Click="HealthSummaryButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="HealthSummaryDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#1DBE86" />
                                    <TextBlock x:Name="HealthSummaryText" Foreground="#29425D" Text="系统状态" />
                                    <TextBlock x:Name="HealthSummaryChevron" Margin="8,0,0,0" Foreground="#61798F" Text="⌃" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="HealthDetailsPanel" Margin="0,8,0,0" Padding="4" Background="#8FFFFFFF" BorderBrush="#C8DAE8" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding HealthItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Right" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MaxWidth="210" Margin="6,4,0,4" Padding="10,7" Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Accent}" />
                                                <TextBlock FontWeight="SemiBold" Foreground="#29425D" Text="{Binding Title}" />
                                            </StackPanel>
                                            <TextBlock Margin="14,3,0,0" FontSize="11" Foreground="#61798F" TextWrapping="Wrap" Text="{Binding Message}" />
                                            <Button Margin="14,6,0,0" Padding="8,4" HorizontalAlignment="Left" Click="OpenDiscordVoiceVideoSettingsButton_Click" Content="打开语音和视频">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource UtilityButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Key}" Value="Discord">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="EmptyStateText" Grid.Row="1" Margin="0,18,0,2" Foreground="#72879A" Text="正在检测音频会话..." />
                    <ListBox x:Name="ApplicationList" Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding Applications}" AllowDrop="True" Focusable="False" FocusVisualStyle="{x:Null}" KeyboardNavigation.IsTabStop="False" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonDown="ApplicationList_PreviewMouseLeftButtonDown" PreviewMouseMove="ApplicationList_PreviewMouseMove" Drop="ApplicationList_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5" Padding="14,12" Background="#BFFFFFFF" BorderBrush="#C8DAE8" BorderThickness="1" CornerRadius="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="0,0,14,0" Style="{StaticResource ProgramCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanRequestSelection}" Checked="ApplicationSelectionChanged" Unchecked="ApplicationSelectionChanged" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#253F5B" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#788A9C" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#277E91" Text="{Binding RouteStatusText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="248" Margin="0,0,7,0">
                                                <ComboBox ItemsSource="{Binding RouteOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedRoute, Mode=TwoWay}" IsEnabled="{Binding CanEditRoute}" SelectionChanged="ApplicationRouteSelectionChanged">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <Border Padding="12,7" Background="#E8F8F7" BorderBrush="#9BDBD6" BorderThickness="1" CornerRadius="11" Visibility="Collapsed">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSharing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#167C78" Text="{Binding RouteDisplayText}" />
                                                </Border>
                                            </Grid>
                                            <Button Padding="9,5" Margin="0,0,7,0" Style="{StaticResource UtilityButton}" Click="HideProgramButton_Click" Content="不再显示" />
                                            <Button Padding="9,5" Margin="0,0,7,0" Style="{StaticResource UtilityButton}" Click="FavoriteButton_Click" Content="{Binding FavoriteButtonText}" />
                                            <Border Padding="10,5" Background="#E8F1FF" CornerRadius="12">
                                                <TextBlock Foreground="#3972BC" Text="{Binding SelectionStatus}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Border x:Name="VoicemeeterRequirementPanel" Style="{StaticResource GlassCard}" Padding="15" Background="#EEFFF3F3" BorderBrush="#F0B0B0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#B6373C" Text="需要安装 Voicemeeter Banana" />
                            <TextBlock Margin="0,3,0,0" Foreground="#8C575A" Text="安装后重启电脑，再点“刷新”。" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Click="DownloadVoicemeeterButton_Click" Content="官方下载" />
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ExperimentalRoutingStatusText" Foreground="#426985" TextWrapping="Wrap" Text="正在检查音频路由..." />
                            <TextBlock x:Name="InstructionText" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="ApplyRoutingButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed" Click="ApplyRoutingButton_Click" Content="开始分享" />
                        <Button x:Name="ScheduleStopButton" Grid.Column="2" Style="{StaticResource UtilityButton}" Margin="0" Click="ScheduleStopButton_Click" Content="定时" />
                    </Grid>
                </Border>

                <Border x:Name="TimerPanel" Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#29425D" Text="定时停止" />
                            <TextBlock x:Name="TimerStatusText" Margin="0,3,0,0" Foreground="#718499" Text="未设置定时停止。" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="5" Click="TimerPresetButton_Click" Content="5 分钟" />
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="15" Click="TimerPresetButton_Click" Content="15 分钟" />
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="30" Click="TimerPresetButton_Click" Content="30 分钟" />
                                <Button Padding="8,4" Style="{StaticResource UtilityButton}" Tag="60" Click="TimerPresetButton_Click" Content="60 分钟" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TimerMinutesText" Width="58" Text="30" VerticalContentAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#627B92" Text="分钟" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StartStopTimerButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="StartStopTimerButton_Click" Content="开始计时" />
                            <Button Style="{StaticResource UtilityButton}" Margin="0" Click="CancelStopTimerButton_Click" Content="取消" />
                        </StackPanel>
                        <Border x:Name="TimerProgressGlow" Grid.ColumnSpan="3" Height="3" Width="96" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#59D6CA" CornerRadius="2" Opacity="0" />
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="12" Background="#EEFFF1F1" BorderBrush="#EAA8A8" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#A42D36" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Height="42" VerticalAlignment="Top" Background="#ECFFFFFF" Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" BorderBrush="#C9DCE9" BorderThickness="0,0,0,1" />
            <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown" />
            <StackPanel Grid.Column="0" Margin="14,0" HorizontalAlignment="Left" IsHitTestVisible="False" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="/Assets/flowcast-logo.png" Stretch="Uniform" />
                <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#25415D" Text="FlowCast" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource WindowCommandButton}" Click="MinimizeWindow_Click" ToolTip="最小化" Content="-" />
                <Button Style="{StaticResource WindowCommandButton}" Click="CloseWindow_Click" ToolTip="关闭" Content="&#215;" />
            </StackPanel>
        </Grid>

        <Border x:Name="LaunchOverlay" Panel.ZIndex="20" Opacity="1" IsHitTestVisible="True">
            <Border.Background>
                <SolidColorBrush Color="#FBFCFF" />
            </Border.Background>
            <Grid>
                <Border x:Name="LaunchRingOuter" Visibility="Collapsed" />
                <Ellipse x:Name="LaunchRingInner" Visibility="Collapsed" />
                <Grid x:Name="LaunchBrand" Width="460" Height="190" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="430" Height="112" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Canvas.Effect>
                            <BlurEffect x:Name="LaunchBrandBlur" Radius="16" />
                        </Canvas.Effect>
                        <Rectangle x:Name="LaunchWaveOne" Canvas.Left="48" Canvas.Top="51" Width="8" Height="20" Fill="#31C2C7" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle x:Name="LaunchWaveTwo" Canvas.Left="66" Canvas.Top="38" Width="8" Height="46" Fill="#38C9CC" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle x:Name="LaunchWaveThree" Canvas.Left="84" Canvas.Top="22" Width="8" Height="78" Fill="#20B6C3" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle x:Name="LaunchWaveFour" Canvas.Left="102" Canvas.Top="38" Width="8" Height="46" Fill="#38C9CC" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5" />
                        <Rectangle x:Name="LaunchWaveFive" Canvas.Left="120" Canvas.Top="51" Width="8" Height="20" Fill="#31C2C7" RadiusX="4" RadiusY="4" RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="LaunchNote" Data="M210,70 L210,26 L249,38 L249,70" Stroke="#25B9C4" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5" />
                        <Ellipse x:Name="LaunchNoteHeadOne" Canvas.Left="194" Canvas.Top="62" Width="27" Height="20" Fill="#25B9C4" RenderTransformOrigin="0.5,0.5" />
                        <Ellipse x:Name="LaunchNoteHeadTwo" Canvas.Left="233" Canvas.Top="62" Width="27" Height="20" Fill="#25B9C4" RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="LaunchSignal" Data="M278,38 Q305,56 278,74 M292,24 Q334,56 292,88" Stroke="#456080" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" RenderTransformOrigin="0.5,0.5" />
                        <Path x:Name="LaunchSignalArrow" Data="M346,46 L362,56 L346,66 Z" Fill="#456080" RenderTransformOrigin="0.5,0.5" />
                    </Canvas>
                    <TextBlock x:Name="LaunchTitle" Margin="0,129,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="SemiBold" Foreground="#163653" Text="FlowCast" />
                    <TextBlock x:Name="LaunchStatusText" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
