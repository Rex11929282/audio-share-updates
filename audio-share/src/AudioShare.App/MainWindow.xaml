<Window x:Class="AudioShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowCast - 音乐分享"
        Icon="/Assets/flowcast-logo.ico"
        Width="940"
        Height="710"
        MinWidth="720"
        MinHeight="560"
        Background="#F4F8FC"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="5" Opacity="0.08" Color="#45678F" />
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="10" ShadowDepth="3" Opacity="0.14" Color="#2477DB" />

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#C9FDFEFF" />
            <Setter Property="BorderBrush" Value="#9EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
        <Style x:Key="UtilityButton" TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#A8FFFFFF" />
            <Setter Property="BorderBrush" Value="#B8D7E1EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#29425D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}">
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#1976F3" />
            <Setter Property="BorderBrush" Value="#5AA7FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E85558" />
            <Setter Property="BorderBrush" Value="#FF9697" />
        </Style>
        <Style x:Key="ProgramCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="22" Height="22" Background="#A8FFFFFF" BorderBrush="#9EB2C9" BorderThickness="1.4" CornerRadius="11">
                            <Path x:Name="Check" Data="M 5,11 L 9,15 L 17,7" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1677F4" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1677F4" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="#D8FFFFFF" />
            <Setter Property="BorderBrush" Value="#B6C7D9" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F7FBFF" Offset="0" />
                    <GradientStop Color="#EDF5FF" Offset="0.55" />
                    <GradientStop Color="#F2FAF8" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse Width="420" Height="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-120,0" Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#A3DBFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="300" Height="270" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-100" Opacity="0.22">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFB9A6" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" Margin="0,0,12,0" Background="#BFFFFFFF" CornerRadius="15" Effect="{StaticResource SoftShadow}">
                        <Image Margin="8" Source="/Assets/flowcast-logo.png" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#172D45" Text="FlowCast" />
                        <TextBlock Margin="1,1,0,0" Foreground="#687D94" Text="音乐分享" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource UtilityButton}" Click="SettingsButton_Click" Content="设置" />
                    <Button Style="{StaticResource UtilityButton}" Click="TutorialButton_Click" Content="教程" />
                    <Button Style="{StaticResource UtilityButton}" Click="CopyDiagnosticsButton_Click" Content="诊断" />
                    <Button x:Name="UpdateButton" Style="{StaticResource UtilityButton}" Visibility="Collapsed" Click="UpdateButton_Click" Content="更新" />
                    <Button x:Name="RefreshButton" Style="{StaticResource UtilityButton}" Margin="0" Click="RefreshButton_Click" Content="刷新" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="70" Height="70" Background="#CFFFFFFF" BorderBrush="#DFFFFFFF" BorderThickness="1" CornerRadius="35" VerticalAlignment="Center">
                        <Viewbox Margin="18">
                            <Path Data="M 4,12 C 4,7 8,4 12,4 C 16,4 20,7 20,12 M 8,12 C 8,9 10,8 12,8 C 14,8 16,9 16,12 M 2,10 L 2,14 M 22,10 L 22,14" Stroke="#12AFC0" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FlowCastStatusText" FontSize="27" FontWeight="SemiBold" Foreground="#117F95" Text="正在确认分享状态" />
                        <TextBlock x:Name="FlowCastStatusHintText" Margin="0,5,0,0" FontSize="14" Foreground="#496C82" TextWrapping="Wrap" Text="正在检查当前程序。" />
                        <TextBlock x:Name="B1StatusText" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#278093" Text="B1：正在检测" />
                        <TextBlock x:Name="RecentActivityText" Margin="0,8,0,0" FontSize="12" Foreground="#70869A" TextWrapping="Wrap" />
                        <StackPanel Margin="0,13,0,0" Orientation="Horizontal" Opacity="0.65">
                            <Rectangle Width="4" Height="10" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="20" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="14" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="27" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="17" Margin="0,0,4,0" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                            <Rectangle Width="4" Height="10" Fill="#36C8C2" RadiusX="2" RadiusY="2" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="RestoreRoutingButton" Grid.Column="2" Style="{StaticResource DangerButton}" VerticalAlignment="Center" IsEnabled="False" Click="RestoreRoutingButton_Click" Content="停止分享" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="22" MinHeight="260">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#203A56" Text="正在播放的程序" />
                            <TextBlock Margin="0,4,0,0" Foreground="#74879A" Text="勾选后，朋友才会听到该程序。" />
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ProcessStatuses}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                    <Border Padding="11,7" Background="#B9F7FFF9" BorderBrush="#A3DECF" BorderThickness="1" CornerRadius="14">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#1DBE86" />
                                            <TextBlock FontWeight="SemiBold" Foreground="#148365" Text="Voicemeeter Banana" />
                                            <TextBlock Margin="5,0,0,0" Foreground="#397767" Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <TextBlock x:Name="EmptyStateText" Grid.Row="1" Margin="0,18,0,2" Foreground="#72879A" Text="正在检测音频会话..." />
                    <ListBox Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding Applications}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5" Padding="14,12" Background="#BFFFFFFF" BorderBrush="#C8DAE8" BorderThickness="1" CornerRadius="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="0,0,14,0" Style="{StaticResource ProgramCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" Checked="ApplicationSelectionChanged" Unchecked="ApplicationSelectionChanged" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#253F5B" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#788A9C" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Padding="9,5" Margin="0,0,7,0" Style="{StaticResource UtilityButton}" Click="HideProgramButton_Click" Content="不再显示" />
                                            <Button Padding="9,5" Margin="0,0,7,0" Style="{StaticResource UtilityButton}" Click="FavoriteButton_Click" Content="{Binding FavoriteButtonText}" />
                                            <Border Padding="10,5" Background="#E8F1FF" CornerRadius="12">
                                                <TextBlock Foreground="#3972BC" Text="{Binding SelectionStatus}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <Border x:Name="VoicemeeterRequirementPanel" Style="{StaticResource GlassCard}" Padding="15" Background="#EEFFF3F3" BorderBrush="#F0B0B0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#B6373C" Text="需要安装 Voicemeeter Banana" />
                            <TextBlock Margin="0,3,0,0" Foreground="#8C575A" Text="安装后重启电脑，再点“刷新”。" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Click="DownloadVoicemeeterButton_Click" Content="官方下载" />
                    </Grid>
                </Border>

                <Border Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ExperimentalRoutingStatusText" Foreground="#426985" TextWrapping="Wrap" Text="正在检查音频路由..." />
                            <TextBlock x:Name="InstructionText" Visibility="Collapsed" />
                        </StackPanel>
                        <Button x:Name="SetupSelectedButton" Grid.Column="1" Style="{StaticResource UtilityButton}" IsEnabled="False" Click="SetupSelectedButton_Click" Content="打开混音器" />
                        <Button x:Name="ApplyRoutingButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="ApplyRoutingButton_Click" Content="开始分享" />
                        <Button x:Name="ScheduleStopButton" Grid.Column="3" Style="{StaticResource UtilityButton}" Margin="0" Click="ScheduleStopButton_Click" Content="定时" />
                    </Grid>
                </Border>

                <Border x:Name="TimerPanel" Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#29425D" Text="定时停止" />
                            <TextBlock x:Name="TimerStatusText" Margin="0,3,0,0" Foreground="#718499" Text="未设置定时停止。" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="5" Click="TimerPresetButton_Click" Content="5 分钟" />
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="15" Click="TimerPresetButton_Click" Content="15 分钟" />
                                <Button Padding="8,4" Margin="0,0,6,0" Style="{StaticResource UtilityButton}" Tag="30" Click="TimerPresetButton_Click" Content="30 分钟" />
                                <Button Padding="8,4" Style="{StaticResource UtilityButton}" Tag="60" Click="TimerPresetButton_Click" Content="60 分钟" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TimerMinutesText" Width="58" Text="30" VerticalContentAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#627B92" Text="分钟" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="StartStopTimerButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="StartStopTimerButton_Click" Content="开始计时" />
                            <Button Style="{StaticResource UtilityButton}" Margin="0" Click="CancelStopTimerButton_Click" Content="取消" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Margin="0,10,0,0" Style="{StaticResource GlassCard}" Padding="12" Background="#EEFFF1F1" BorderBrush="#EAA8A8" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#A42D36" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
