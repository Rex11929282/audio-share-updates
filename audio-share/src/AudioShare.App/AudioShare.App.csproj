<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RequireVoicemod Condition="'$(RequireVoicemod)' == ''">true</RequireVoicemod>
    <DefineConstants Condition="'$(RequireVoicemod)' == 'true'">$(DefineConstants);REQUIRE_VOICEMOD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioShare.Core\AudioShare.Core.csproj" />
    <ProjectReference Include="..\AudioShare.Windows\AudioShare.Windows.csproj" />
  </ItemGroup>

</Project>
