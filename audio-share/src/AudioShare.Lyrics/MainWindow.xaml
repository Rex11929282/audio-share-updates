<Window x:Class="AudioShare.Lyrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FlowCast Lyrics"
        Height="92"
        Width="680"
        MinHeight="92"
        MinWidth="680"
        MaxHeight="92"
        MaxWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="WindowSurface"
            Margin="1"
            Background="#F2EFFAFF"
            BorderBrush="#D8FFFFFF"
            BorderThickness="1"
            CornerRadius="46"
            PreviewMouseLeftButtonDown="WindowSurface_OnPreviewMouseLeftButtonDown">
        <Grid ClipToBounds="True">
            <wv2:WebView2CompositionControl x:Name="OverlayWebView"
                                            Margin="0"
                                            Visibility="Hidden" />

            <Border x:Name="NativeFallback"
                    Margin="4"
                    Background="#ECF3FBFF"
                    BorderBrush="#C8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="42">
                <TextBlock x:Name="FallbackStatusText"
                           Margin="30,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#17384F"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Text="正在尋找 FlowCast"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
