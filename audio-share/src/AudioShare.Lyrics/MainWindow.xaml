<Window x:Class="AudioShare.Lyrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FlowCast Lyrics"
        Height="44"
        Width="180"
        MinHeight="44"
        MinWidth="180"
        MaxHeight="92"
        MaxWidth="680"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border x:Name="WindowSurface"
            Margin="0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="22"
            PreviewMouseLeftButtonDown="WindowSurface_OnPreviewMouseLeftButtonDown"
            PreviewMouseRightButtonUp="WindowSurface_OnPreviewMouseRightButtonUp">
        <Border.ContextMenu>
            <ContextMenu x:Name="CapsuleContextMenu">
                <MenuItem Header="Adjust Liquid Glass…" Click="AdjustLiquidGlass_OnClick" />
                <Separator />
                <MenuItem Header="Close FlowCast Lyrics" Click="CloseFlowCastLyrics_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid ClipToBounds="True">
            <wv2:WebView2CompositionControl x:Name="OverlayWebView"
                                            Margin="0"
                                            Visibility="Hidden" />

            <Border x:Name="NativeFallback"
                    Margin="4"
                    Background="#ECF3FBFF"
                    BorderBrush="#C8FFFFFF"
                    BorderThickness="1"
                    CornerRadius="18">
                <TextBlock x:Name="FallbackStatusText"
                           Margin="20,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#17384F"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="等待播放"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
