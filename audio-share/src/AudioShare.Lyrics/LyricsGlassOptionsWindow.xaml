<Window x:Class="AudioShare.Lyrics.LyricsGlassOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Border Padding="16" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
        <StackPanel>
            <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="玻璃效果" />

            <TextBlock Text="圓角" />
            <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="CornerRadiusSlider_OnValueChanged" />

            <TextBlock Margin="0,8,0,0" Text="模糊" />
            <Slider x:Name="BlurRadiusSlider" Minimum="0" Maximum="32" SmallChange="1" LargeChange="4" ValueChanged="BlurRadiusSlider_OnValueChanged" />

            <TextBlock Margin="0,8,0,0" Text="折射高度" />
            <Slider x:Name="RefractionHeightSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="RefractionHeightSlider_OnValueChanged" />

            <TextBlock Margin="0,8,0,0" Text="折射強度" />
            <Slider x:Name="RefractionAmountSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" ValueChanged="RefractionAmountSlider_OnValueChanged" />

            <CheckBox x:Name="ChromaticAberrationCheckBox" Margin="0,12,0,16" Content="色差" Checked="ChromaticAberrationCheckBox_OnChanged" Unchecked="ChromaticAberrationCheckBox_OnChanged" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,4,0" MinWidth="64" Padding="4" Content="重設" Click="ResetButton_OnClick" />
                <Button Grid.Column="1" Margin="0,0,4,0" MinWidth="64" Padding="4" Content="取消" Click="CancelButton_OnClick" />
                <Button Grid.Column="2" Margin="0,0,4,0" MinWidth="64" Padding="4" Content="完成" Click="CompleteButton_OnClick" />
                <Button Grid.Column="3" MinWidth="64" Padding="4" Content="關閉" Click="CloseButton_OnClick" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
