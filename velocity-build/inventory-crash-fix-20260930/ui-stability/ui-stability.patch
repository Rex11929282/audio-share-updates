+        if ( has( category, "glove" ) ) return inventory( 8 );
+        if ( has( category, "agent" ) ) return inventory( 9 );
+        if ( has( category, "skin" ) || has( category, "paint" ) || has( category, "sticker" ) || has( category, "wear" ) ) return inventory( );
+        if ( has( category, "lua" ) || has( category, "script" ) ) return config( true );
+        if ( has( category, "config" ) ) return config( );
+        if ( has( category, "watermark" ) || has( category, "glass widget" ) ) return profile( );
+        if ( has( category, "profile" ) ) return profile( 1 );
+        if ( has( category, "widgets" ) ) return layout_editor( );
+        if ( has( category, "camera" ) || ( category == "viewmodel" && name == "viewmodel adjust" ) ) return misc( 3 );
+        if ( has( category, "removals" ) ) return misc( 5 );
+        if ( has( category, "scene" ) || has( category, "weather" ) || has( category, "post process" ) ) return misc( 2 );
+        if ( has( category, "other esp" ) || has( category, "projectile" ) || has( category, "inferno" ) || has( category, "items" ) ) return misc( 1 );
+        if ( has( category, "enemy" ) || has( category, "backtrack" ) || has( category, "onshot" ) ) return player( 0 );
+        if ( has( category, "team" ) || has( category, "allies" ) || has( category, "friendly" ) ) return player( 1 );
+        if ( has( category, "local" ) || has( category, "viewmodel" ) ) return player( 2 );
+        if ( category == "esp" || category == "chams" || category == "glow" ) return player( 0 );
+        if ( category == "crosshair" || has( category, "scope overlay" ) || category == "hat" || has( category, "velocity hud" ) ) return misc( 4 );
+        return misc( 0 );
+    }
