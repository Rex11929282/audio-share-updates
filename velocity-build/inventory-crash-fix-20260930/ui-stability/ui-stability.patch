+#pragma once
+#include <cstddef>
+#include <type_traits>
+#include <unordered_map>
+
+// Diagnostic metadata only. Never dispatches keys or changes feature settings.
+namespace rendering::hotkey_ui {
+    enum class family { general, rage, legit };
+    struct scope { family mode{ family::general }; std::size_t group{}; };
+
+    constexpr bool overlaps( scope a, scope b, bool explicit_exclusion = false ) noexcept {
+        if ( explicit_exclusion || a.mode == family::general || b.mode == family::general ) return true;
+        // Only one replacement weapon group is consumed at a time. Combat mode
+        // selection is mutually exclusive for feature values, not master hotkeys.
+        return a.mode == b.mode && a.group == b.group;
+    }
+
+    template<class Rage, class Legit>
+    auto describe_groups( const Rage& rage, const Legit& legit ) {
+        using setting_type = std::remove_cvref_t<decltype( rage.global.silent )>;
+        std::unordered_map<const setting_type*, scope> result;
+        const auto add_rage = [&]( const auto& group, std::size_t id ) {
+            const setting_type* values[]{ &group.silent, &group.no_spread, &group.doubletap,
+                &group.body_aim, &group.force_shot_air, &group.force_shot,
+                &group.min_damage_override, &group.hitchance_override,
+                &group.dynamic_pointscale };
+            for ( const auto* value : values ) result.emplace( value, scope{ family::rage, id } );
+        };
+        const auto add_legit = [&]( const auto& group, std::size_t id ) {
+            const setting_type* values[]{ &group.aimbot, &group.rcs, &group.standalone_rcs,
+                &group.triggerbot, &group.trigger_head_only, &group.give_me_your_seed,
+                &group.autowall, &group.visualize_fov };
+            for ( const auto* value : values ) result.emplace( value, scope{ family::legit, id } );
+        };
+        add_rage( rage.global, 0 );
+        add_legit( legit.global, 0 );
+        std::size_t id = 1;
+        for ( const auto& group : rage.groups ) add_rage( group, id++ );
+        for ( const auto& weapon : rage.weapons ) add_rage( weapon.values, id++ );
+        id = 1;
+        for ( const auto& group : legit.groups ) add_legit( group, id++ );
+        for ( const auto& weapon : legit.weapons ) add_legit( weapon.values, id++ );
+        // The debug-point overlay is also intentionally absent: its cached rendering
+        // can outlive a combat-mode switch.
+        // Masters and category/weapon override switches are intentionally absent:
+        // dispatching those can change modes/scopes and must still warn on reuse.
+        return result;
+    }
+}
