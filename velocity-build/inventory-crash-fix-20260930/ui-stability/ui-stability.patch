+    constexpr search_route config( bool scripts = false ) { return { 6, scripts ? 1 : 0, scripts ? 7 : 8 }; }
+    constexpr search_route profile( int selected = 0 ) { return { 5, 0, 9, 0, -1, selected }; }
+    constexpr search_route layout_editor( ) { return { 5, 0, 9, 0, -1, 0, true }; }
+    constexpr search_route hotkeys( ) { return { 5, 0, 9, 0, -1, 1, false, true }; }
+
+    constexpr bool has( std::string_view text, std::string_view word ) { return text.find( word ) != std::string_view::npos; }
+    constexpr int weapon_group( std::string_view category ) {
+        if ( has( category, "pistol" ) ) return 0;
+        if ( has( category, "smg" ) ) return 1;
+        if ( has( category, "rifle" ) ) return 2;
+        if ( has( category, "shotgun" ) ) return 3;
+        if ( has( category, "sniper" ) ) return 4;
+        if ( has( category, "lmg" ) ) return 5;
+        return 0;
+    }
+    constexpr search_route category_route( std::string_view category, std::string_view name = {} ) {
+        if ( has( category, "anti aim" ) ) return combat( 2 );
+        if ( has( category, "legitbot" ) ) return combat( 1, weapon_group( category ) );
+        if ( has( category, "ragebot" ) || has( category, "autos" ) || has( category, "peek assistance" ) ||
+             has( category, "zeusbot" ) || has( category, "knifebot" ) || has( category, "other 'bots'" ) ) return combat( 0, weapon_group( category ) );
+        if ( has( category, "changer ui" ) ) return inventory( );
