+    constexpr float minimum_window_width = 700.0f;
+    constexpr float clamp_window_width( float requested, float available ) {
+        return std::clamp( requested, std::min( minimum_window_width, available ), available );
+    }
+
+    struct section_focus {
+        int index{ -1 };
+        float previous_offset{ -1.0f };
+        int stable_frames{};
+        void request( int section ) { index = section; previous_offset = -1.0f; stable_frames = 0; }
+        bool update( float offset, bool user_scrolling ) {
+            if ( index < 0 || user_scrolling ) { index = -1; return false; }
+            stable_frames = offset == previous_offset ? stable_frames + 1 : 0;
+            previous_offset = offset;
+            if ( stable_frames >= 2 ) index = -1;
+            return true;
+        }
+    };
+
