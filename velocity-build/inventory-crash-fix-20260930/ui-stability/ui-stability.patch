+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace rendering::viewport {
+
+    // Clamp draw coordinates only; leave saved user offsets and animation state intact.
+    // An oversized widget starts at the viewport edge instead of using an inverted range.
+    [[nodiscard]] inline float clamp_origin( float origin, float extent, float viewport_extent ) noexcept
+    {
+        if ( !std::isfinite( origin ) || !std::isfinite( extent ) || !std::isfinite( viewport_extent ) || extent < 0.0f || viewport_extent <= 0.0f )
+            return 0.0f;
+
+        return std::clamp( origin, 0.0f, std::max( 0.0f, viewport_extent - extent ) );
+    }
+
+} // namespace rendering::viewport
