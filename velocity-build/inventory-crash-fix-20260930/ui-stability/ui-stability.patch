+        [[nodiscard]] static std::size_t next_utf8_boundary( std::string_view text, std::size_t begin )
+        {
+            auto end = begin + 1;
+            while ( end < text.size( ) && ( static_cast<unsigned char>( text[ end ] ) & 0xc0 ) == 0x80 ) ++end;
+            return std::min( end, text.size( ) );
