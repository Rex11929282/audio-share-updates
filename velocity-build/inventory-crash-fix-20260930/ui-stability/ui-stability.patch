+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include "viewport_bounds.hpp"
+
+// UI geometry only. No entity, gameplay, input-hook, or configuration dependencies.
+namespace rendering::hud_layout {
+    enum class component : std::size_t { watermark, keybinds, status, spectators, bomb, stats, count };
+    constexpr std::size_t count = static_cast<std::size_t>( component::count );
+    struct rect {
+        float x{}, y{}, w{}, h{};
+        float right() const { return x + w; }
+        float bottom() const { return y + h; }
+        bool contains(float px, float py) const { return px >= x && py >= y && px < right() && py < bottom(); }
+    };
+    inline bool valid(rect r) {
+        return std::isfinite(r.x) && std::isfinite(r.y) && std::isfinite(r.w) && std::isfinite(r.h) && r.w > 0 && r.h > 0;
+    }
+    struct rendered_node {
+        bool visible{};
+        rect bounds{};
+        // Origin of the union before saved offsets and viewport clamping.
+        float base_x{}, base_y{};
+        unsigned order{};
+    };
+    struct registry {
+        std::array<rendered_node, count> nodes{};
+        unsigned order{};
+        void begin_frame() { nodes = {}; order = 0; }
+        void add(component id, rect r, float base_x, float base_y) {
+            if (static_cast<std::size_t>(id) >= count || !valid(r) || !std::isfinite(base_x) || !std::isfinite(base_y)) return;
+            auto& n = nodes[static_cast<std::size_t>(id)];
+            if (n.visible) {
+                const float right = std::max(n.bounds.right(), r.right());
+                const float bottom = std::max(n.bounds.bottom(), r.bottom());
+                n.bounds.x = std::min(n.bounds.x, r.x); n.bounds.y = std::min(n.bounds.y, r.y);
+                n.bounds.w = right - n.bounds.x; n.bounds.h = bottom - n.bounds.y;
+                n.base_x = std::min(n.base_x, base_x); n.base_y = std::min(n.base_y, base_y);
+            } else { n.visible = true; n.bounds = r; n.base_x = base_x; n.base_y = base_y; }
+            n.order = ++order;
+        }
+    };
+    inline registry rendered;
+    struct value { float x{}, y{}, scale{1.0f}; };
+    struct binding {
+        float* x{}; float* y{}; float* scale{}; bool enabled{};
+        bool valid() const { return x && y && scale; }
+        value read() const { return {*x, *y, *scale}; }
+        void write(value v) const { *x = v.x; *y = v.y; *scale = v.scale; }
+    };
+    using bindings = std::array<binding, count>;
+    struct pointer {
+        float x{}, y{};
+        bool down{}, pressed{}, released{}, escape{}, cancel{}, free_move{};
+    };
+    enum class corner { none, top_left, top_right, bottom_left, bottom_right };
+    inline bool left(corner c) { return c == corner::top_left || c == corner::bottom_left; }
+    inline bool top(corner c) { return c == corner::top_left || c == corner::top_right; }
+    inline rect handle(rect r, corner c) {
+        // Keep handles inside the real rectangle so edge-aligned widgets remain selectable.
+        const float size = std::min({10.0f, r.w * 0.5f, r.h * 0.5f});
+        return {left(c) ? r.x : r.right()-size, top(c) ? r.y : r.bottom()-size, size, size};
+    }
+    inline corner hit_corner(rect r, float x, float y) {
+        for (auto c : {corner::top_left, corner::top_right, corner::bottom_left, corner::bottom_right})
+            if (handle(r,c).contains(x,y)) return c;
+        return corner::none;
+    }
+    struct guide { bool visible{}; float position{}; };
+    struct editor {
+        bool open{};
+        bool snapping{true};
+        int selected{-1};
+        int captured{-1};
+        corner resizing{corner::none};
+        guide vertical{}, horizontal{};
+        std::array<value,count> original{};
+        value gesture_original{};
+        rect initial{};
+        float press_x{}, press_y{}, viewport_w{}, viewport_h{};
+        // A resize uses next-frame measured dimensions, including unscaled text.
+        bool settle_resize{};
+        float fixed_x{}, fixed_y{};
+        void start(const bindings& b) {
+            for (std::size_t i=0; i<count; ++i) if (b[i].valid()) original[i] = b[i].read();
+            open=true; selected=captured=-1; resizing=corner::none; settle_resize=false;
+            vertical={}; horizontal={}; viewport_w=viewport_h=0;
+        }
+        void cancel_gesture(const bindings& b) {
+            if (captured >= 0 && b[captured].valid()) b[captured].write(gesture_original);
+            captured=-1; resizing=corner::none; settle_resize=false; vertical={}; horizontal={};
+        }
+        void finish(const bindings& b, bool keep) {
+            if (!keep) { for (std::size_t i=0; i<count; ++i) if (b[i].valid()) b[i].write(original[i]); }
+            else if (captured>=0) cancel_gesture(b);
+            open=false; captured=-1; resizing=corner::none; settle_resize=false; vertical={}; horizontal={};
+        }
+        bool usable(int i,const registry& r,const bindings& b) const {
+            return i>=0 && i<static_cast<int>(count) && r.nodes[i].visible && b[i].valid() && b[i].enabled &&
+                std::isfinite(*b[i].x) && std::isfinite(*b[i].y) && std::isfinite(*b[i].scale);
+        }
+        static void closest(float moving, float target, float& distance, float& correction, guide& line) {
+            const float d=target-moving;
+            if (std::abs(d)<distance) { distance=std::abs(d); correction=d; line={true,target}; }
+        }
+        void snap(rect& desired,const registry& r,const bindings& b,float vw,float vh) {
+            float dx=0,dy=0,near_x=7.0f,near_y=7.0f;
+            const std::array<float,3> xs{desired.x,desired.x+desired.w*0.5f,desired.right()};
+            const std::array<float,3> ys{desired.y,desired.y+desired.h*0.5f,desired.bottom()};
+            for(float x:xs) for(float t:{0.0f, vw*0.5f, vw}) closest(x,t,near_x,dx,vertical);
+            for(float y:ys) for(float t:{0.0f, vh*0.5f, vh}) closest(y,t,near_y,dy,horizontal);
+            for(int i=0;i<static_cast<int>(count);++i) if(i!=captured && usable(i,r,b)) {
+                const auto n=r.nodes[i].bounds;
+                for(float x:xs) for(float t:{n.x,n.x+n.w*0.5f,n.right()}) closest(x,t,near_x,dx,vertical);
+                for(float y:ys) for(float t:{n.y,n.y+n.h*0.5f,n.bottom()}) closest(y,t,near_y,dy,horizontal);
+            }
+            desired.x+=dx; desired.y+=dy;
+        }
+        void place(const rendered_node& n,const binding& b,rect desired,float vw,float vh) {
+            *b.x=viewport::clamp_origin(desired.x,desired.w,vw)-n.base_x;
+            *b.y=viewport::clamp_origin(desired.y,desired.h,vh)-n.base_y;
+        }
+        void anchor_resize(const registry& r,const bindings& b,float vw,float vh) {
+            if(!usable(selected,r,b)) return;
+            const auto& n=r.nodes[selected]; auto desired=n.bounds;
+            desired.x=left(resizing)?fixed_x-desired.w:fixed_x;
+            desired.y=top(resizing)?fixed_y-desired.h:fixed_y;
+            place(n,b[selected],desired,vw,vh);
+        }
+        void update(const registry& r,const bindings& b,pointer p,float vw,float vh,bool blocked=false) {
+            if(!open) return;
+            vertical={}; horizontal={};
+            if(!std::isfinite(vw) || !std::isfinite(vh) || vw<=0 || vh<=0 || p.cancel) {
+                cancel_gesture(b); return;
+            }
+            if(viewport_w>0 && (vw!=viewport_w || vh!=viewport_h)) { cancel_gesture(b); viewport_w=vw;viewport_h=vh;return; }
+            viewport_w=vw; viewport_h=vh;
+            if(captured>=0 && (!usable(captured,r,b) || !std::isfinite(p.x) || !std::isfinite(p.y))) { cancel_gesture(b); return; }
+            if(p.escape) { if(captured>=0) cancel_gesture(b); else finish(b,false); return; }
+            if(settle_resize) { anchor_resize(r,b,vw,vh); settle_resize=false; resizing=corner::none; }
+            if(captured<0 && p.pressed && !blocked) {
+                int hit=-1;
+                for(int i=0;i<static_cast<int>(count);++i) if(usable(i,r,b) && r.nodes[i].bounds.contains(p.x,p.y))
+                    if(hit<0 || r.nodes[i].order>r.nodes[hit].order) hit=i;
+                selected=hit;
+                if(hit>=0) {
+                    captured=hit; initial=r.nodes[hit].bounds; gesture_original=b[hit].read();
+                    press_x=p.x;press_y=p.y;resizing=hit_corner(initial,p.x,p.y);
